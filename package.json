{
  "name": "opencode-notifications-with-questions",
  "version": "0.3.0",
  "description": "OpenCode 2.x plugin that publishes idle, error, permission and question notifications via a selectable transport: ntfy (default), Gotify, or Web Push (end-to-end encrypted, no app needed).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "plugin",
    "ntfy",
    "gotify",
    "webpush",
    "notification",
    "push"
  ],
  "author": "Maciej Bochynski",
  "repository": {
    "type": "git",
    "url": "https://github.com/maboch/opencode-ntfy-with-questions"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opencode-notifications-bootstrap": "./dist/bootstrap-service.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./notification-notifications-with-questions.schema.json": {
      "import": "./notification-notifications-with-questions.schema.json",
      "require": "./notification-notifications-with-questions.schema.json",
      "default": "./notification-notifications-with-questions.schema.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "notification-notifications-with-questions.schema.json"
  ],
  "engines": {
    "opencode": ">=2.0.20 <3.0.0",
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bootstrap-service.js",
    "clean": "rm -rf dist coverage node_modules"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.17.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.20",
    "web-push": "4.0.0"
  }
}
